# Defensas de la cadena de suministro para las dependencias de la Web UI.
# No instala versiones publicadas hace menos de 7 días: la mayoría de los paquetes comprometidos se detectan y retiran
# antes. Para una corrección urgente: npm install --min-release-age=0 …
min-release-age=7
# Los paquetes no ejecutan scripts al instalarse (el vector habitual de esos ataques); ninguna dependencia los necesita.
ignore-scripts=true
# Las versiones quedan fijas en package.json, sin ^ ni ~.
save-exact=true
