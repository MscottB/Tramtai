<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS delante del servidor de Tramtai, con Application Request Routing (ARR) y URL Rewrite: el sitio tiene un enlace
  HTTPS en el 443 con el certificado de tramtai.example.com, y Tramtai escucha solo en este equipo (127.0.0.1:17373).
  El sitio no debe tener otro enlace HTTP que el de la regla que redirige a HTTPS: Tramtai solo acepta la contraseña
  cuando el proxy dice X-Forwarded-Proto: https, y aquí solo se dice si la petición llegó por HTTPS.

  Lo que no se puede poner en un web.config, una vez, desde una consola de administrador:
    %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/proxy /enabled:"True" /preserveHostHeader:"True" /responseBufferLimit:"0" /timeout:"01:00:00" /commit:apphost
    %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_PROTO']" /commit:apphost
  preserveHostHeader conserva el Host; responseBufferLimit="0" quita el búfer, para que el flujo en vivo (SSE) llegue
  trozo a trozo; timeout deja hasta una hora a una petición larga. ARR añade la dirección de quien conecta (con su
  puerto) al X-Forwarded-For que traiga la petición: Tramtai toma el último salto, el que añadió ARR.

  Solo TLS 1.3: en IIS se elige en Schannel, para todo el equipo (Windows Server 2022 o posterior). Desactiva TLS 1.0,
  1.1 y 1.2 del lado del servidor en HKLM\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols y
  reinicia; comprueba antes que nada más de este equipo necesita TLS 1.2.

  En %ProgramData%\Tramtai\config.yaml:
    servicio:
      host: 127.0.0.1
      dominios: [tramtai.example.com]
      proxy:
        confiables: [127.0.0.1/32]
  No añadas HSTS (Strict-Transport-Security): lo pone Tramtai.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Tramtai: HTTP a HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Tramtai" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^ON$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:17373/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Sin compresión dinámica: comprimir obliga a guardar la respuesta y corta el flujo en vivo. -->
    <urlCompression doDynamicCompression="false" />
    <!-- Las cargas de archivos (conversion.maximo_carga_mb, 50 MB por defecto). -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="67108864" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
