{
  "es": [
    {
      "id": "extraer",
      "nombre": "Extraer datos",
      "instrucciones": "Extrae del texto los datos pedidos. Si la fecha o el total no aparecen, omite ese campo.",
      "esquema": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre de la persona o empresa"
          },
          "fecha": {
            "type": "string",
            "format": "date",
            "description": "Fecha del documento (AAAA-MM-DD)"
          },
          "total": {
            "type": "number",
            "description": "Importe total, sin símbolo de moneda"
          }
        },
        "required": [
          "nombre"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "clasificar",
      "nombre": "Clasificar",
      "instrucciones": "Clasifica el texto en una de las categorías.",
      "esquema": {
        "type": "object",
        "properties": {
          "categoria": {
            "type": "string",
            "enum": [
              "consulta",
              "queja",
              "otro"
            ],
            "description": "La categoría que mejor encaja"
          },
          "confianza": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "De 0 a 1"
          },
          "motivo": {
            "type": "string",
            "description": "Por qué esa categoría, en una frase"
          }
        },
        "required": [
          "categoria",
          "confianza",
          "motivo"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "resumen",
      "nombre": "Resumen en puntos",
      "instrucciones": "Resume el texto y enumera sus ideas clave.",
      "esquema": {
        "type": "object",
        "properties": {
          "resumen": {
            "type": "string",
            "description": "Resumen en dos o tres frases"
          },
          "puntos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3,
            "maxItems": 7,
            "description": "Las ideas clave"
          }
        },
        "required": [
          "resumen",
          "puntos"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "sentimiento",
      "nombre": "Sentimiento",
      "instrucciones": "Indica el sentimiento del texto.",
      "esquema": {
        "type": "object",
        "properties": {
          "sentimiento": {
            "type": "string",
            "enum": [
              "positivo",
              "neutral",
