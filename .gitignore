# Binarios y bases locales
/bin/
/dist/
*.db
*.db-wal
*.db-shm

# Documentos de trabajo (Word/PDF): se guardan en documentos/ y no se versionan
/documentos/
*.docx
*.pdf
~$*
# salvo las muestras de la prueba real del conversor (TestConversorReal y el paquete del conversor en Publicar)
!/internal/documentos/testdata/muestra.docx
!/internal/documentos/testdata/muestra.pdf

# Herramientas locales
graphify-out/
node_modules/
# recursos de Windows generados por scripts/compilar.ps1 en cada compilación
*.syso

# Capturas de revisión de diseño (locales)
.impeccable/review/

# worktrees de agentes de Claude Code
/.claude/

# paquetes de Linux generados por scripts/linux/empaquetar.sh
/paquete/

# Notas de versión en preparación (scripts/version.ps1 -Resumen notas-es.txt -ResumenEn notas-en.txt)
notas-*.txt

# Binarios compilados a mano (go build en la carpeta de un paquete main): nunca van al repo.
*.exe

# Copia de docs/ejemplos que hace el workflow de la página (y la vista previa local)
/site/ejemplos/

# Notas de trabajo locales (planes de los agentes y revisiones de estilo): nunca van al repo.
/.superpowers/
/anti-slop/
